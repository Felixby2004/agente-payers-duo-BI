PORT=5173
# Configurar cuando el servidor reciba webhooks desde Internet.
PUBLIC_URL=
NGROK_DOMAIN=
ADMIN_PASSWORD=
SESSION_SECRET=
# Activa después de aplicar la creación/actualización de la base en Supabase.
PAYERS_PORTAL=true
ADMIN_USERNAME=admin
# URL pública HTTPS de la imagen de la carta en res.cloudinary.com.
PUBLIC_MENU_IMAGE_URL=

# Configurar ambos para persistir en Supabase. Sin ellos se usa PostgreSQL local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# local | mercado_pago. Nunca usar una cuenta vendedora real.
PAYMENT_MODE=local
MP_TEST_ACCESS_TOKEN=
MP_TEST_SELLER_ID=
MP_TEST_BUYER_ID=
# Opcional. El comprador puede identificarse al iniciar sesión en Checkout Pro.
MP_TEST_BUYER_EMAIL=
MP_WEBHOOK_SECRET=

# off | cloud. En cloud, WA_ALLOWED_PHONES vacío atiende a cualquier número.
WHATSAPP_MODE=off
WA_GRAPH_VERSION=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Modo abierto por defecto. Si se llena, solo atiende a esos números (coma-separados, con código de país).
WA_ALLOWED_PHONES=
# Números ignorados por completo (coma-separados, mismo formato).
WA_BLOCKED_PHONES=
# Alta de reservas por mensaje estructurado: off | staff | open. Por defecto, apagado.
WA_RESERVATION_MODE=open
# Números autorizados para dar de alta reservas cuando el modo es staff (coma-separados).
WA_RESERVATION_STAFF=
# Límite por número para proteger la demo: máximo de mensajes en una ventana deslizante.
WA_RATE_LIMIT_MAX=20
WA_RATE_LIMIT_WINDOW_MS=600000
# Opcionales. Plantilla de anticipo: 3 variables de cuerpo y botón URL dinámico.
# La de pago rechazado usa las mismas 3 variables y un botón URL dinámico; envíala para reintentar el pago.
# Plantilla de saldo: 3 variables de cuerpo (nombre, referencia, importe) y botón URL dinámico a /pago/.
# Confirmación: 5 variables de cuerpo y botón URL dinámico a /comprobante/.
# Liquidación final: 4 variables de cuerpo y botón URL dinámico a /comprobante/.
# Visita usa 4 variables de cuerpo. Ver README para el orden exacto.
WA_TEMPLATE_DEPOSIT=
WA_TEMPLATE_BALANCE=
WA_TEMPLATE_PAYMENT_REJECTED=
WA_TEMPLATE_VISIT=
WA_TEMPLATE_CONFIRMATION=
WA_TEMPLATE_BALANCE_RECEIPT=
WA_TEMPLATE_SETTLEMENT=
# Plantilla aprobada para avisar una reprogramación iniciada desde el panel (4 variables de cuerpo: nombre, referencia, fecha anterior y nueva).
WA_TEMPLATE_RESCHEDULE=
# Plantilla Meta de autenticación OTP con botón de copiar código.
WA_TEMPLATE_OTP=
WA_TEMPLATE_OTP_LANGUAGE=es
WA_OTP_FREE_FORM=false
WA_TEMPLATE_LANGUAGE=es_PE
ENABLE_REMINDERS=false

# n8n procesa la cola de WhatsApp y activa los avisos programados.
# El modo server permite ejecutar la integración anterior sin n8n.
AGENT_ORCHESTRATION=server
N8N_AGENT_TOKEN=
N8N_PORT=5678
N8N_RUNNERS_BROKER_PORT=5679
# URL local que start-demo.ps1 inyecta al proceso PAYERS para despertar el workflow activo.
N8N_WAKE_URL=

# Requerida para interpretar imágenes y transcribir audios.
OPENAI_API_KEY=
OPENAI_PAYERS_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

DEPOSIT_PER_PERSON=20
DEPOSIT_DEADLINE_MINUTES=120
ARRIVAL_GRACE_MINUTES=15

